{
  "name": "avea",
  "displayName": "Avea",
  "description": "Avea: Another Visual studio code Extension for Agda",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "publisher": "stickypiston",
  "license": "MIT",
  "categories": [
    "Programming Languages"
  ],
  "repository": "github:stickyPiston/avea",
  "main": "./bundle.js",
  "contributes": {
    "configuration": {
      "title": "",
      "type": "object",
      "properties": {
        "agda-mode.agda-path": {
          "type": "string",
          "description": "Path to the agda binary, when left empty, the agda binary on the PATH is used. If you change this setting, you can restart the agda process used by the extension with the restart command (C-c C-x C-r)."
        },
        "agda-mode.extra-args": {
          "type": "string",
          "description": "Extra arguments passed to the Agda process."
        }
      }
    },
    "languages": [
      {
        "id": "agda",
        "extensions": [
          ".agda"
        ],
        "aliases": ["Agda", "agda"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "agda",
        "scopeName": "source.agda",
        "path": "./syntaxes/agda.tmLanguage.json"
      }
    ],
    "keybindings": [
      {
        "command": "avea.load-file",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+l"
      },
      {
        "command": "avea.goal-context",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+e",
        "args": { "rewrite": "AsIs" }
      },
      {
        "command": "avea.goal-context",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+c ctrl+e",
        "args": { "rewrite": "HeadNormal" }
      },
      {
        "command": "avea.goal-context",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+u ctrl+c ctrl+e",
        "args": { "rewrite": "Normalised" }
      },
      {
        "command": "avea.goal-type",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+t",
        "args": { "rewrite": "AsIs" }
      },
      {
        "command": "avea.goal-type",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+c ctrl+t",
        "args": { "rewrite": "HeadNormal" }
      },
      {
        "command": "avea.goal-type",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+u ctrl+c ctrl+t",
        "args": { "rewrite": "Normalised" }
      },
      {
        "command": "avea.goal-env",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+,",
        "args": { "rewrite": "AsIs" }
      },
      {
        "command": "avea.goal-env",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+c ctrl+,",
        "args": { "rewrite": "HeadNormal" }
      },
      {
        "command": "avea.goal-env",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+u ctrl+c ctrl+,",
        "args": { "rewrite": "Normalised" }
      },
      {
        "command": "avea.goal-context-infer",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+.",
        "args": { "rewrite": "AsIs" }
      },
      {
        "command": "avea.goal-context-infer",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+c ctrl+.",
        "args": { "rewrite": "HeadNormal" }
      },
      {
        "command": "avea.goal-context-infer",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+u ctrl+c ctrl+.",
        "args": { "rewrite": "Normalised" }
      },
      {
        "command": "avea.goal-context-elab",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+;",
        "args": { "rewrite": "AsIs" }
      },
      {
        "command": "avea.goal-context-elab",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+c ctrl+;",
        "args": { "rewrite": "HeadNormal" }
      },
      {
        "command": "avea.goal-context-elab",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+u ctrl+c ctrl+;",
        "args": { "rewrite": "Normalised" }
      },
      {
        "command": "avea.next-goal",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+f"
      },
      {
        "command": "avea.prev-goal",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+b"
      },
      {
        "command": "avea.show-metas",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+shift+/",
        "args": { "rewrite": "AsIs" }
      },
      {
        "command": "avea.show-metas",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+c ctrl+shift+/",
        "args": { "rewrite": "HeadNormal" }
      },
      {
        "command": "avea.show-metas",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+u ctrl+c ctrl+shift+/",
        "args": { "rewrite": "Normalised" }
      },
      {
        "command": "avea.show-constraints",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+=",
        "args": { "rewrite": "AsIs" }
      },
      {
        "command": "avea.show-constraints",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+c ctrl+=",
        "args": { "rewrite": "HeadNormal" }
      },
      {
        "command": "avea.show-constraints",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+u ctrl+c ctrl+=",
        "args": { "rewrite": "Normalised" }
      },
      {
        "command": "avea.refine",
        "when": "editorLangId =~ /agda/",
        "key": "ctrl+u ctrl+c ctrl+r",
        "args": {
          "pmLambda": true
        }
      },
      {
        "command": "avea.refine",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+r",
        "args": {
          "pmLambda": false
        }
      },
      {
        "command": "avea.give-goal",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+spc",
        "args": {
          "pmLambda": false
        }
      },
      {
        "command": "avea.give-goal",
        "when": "editorLangId =~ /agda/",
        "key": "ctrl+u ctrl+c ctrl+spc",
        "args": {
          "pmLambda": true
        }
      },
      {
        "command": "avea.backspace",
        "when": "agda-mode.inInputMode",
        "key": "backspace"
      },
      {
        "command": "avea.arrow-left",
        "when": "agda-mode.inInputMode",
        "key": "left"
      },
      {
        "command": "avea.arrow-right",
        "when": "agda-mode.inInputMode",
        "key": "right"
      },
      {
        "command": "avea.escape",
        "when": "agda-mode.inInputMode",
        "key": "escape"
      },
      {
        "command": "avea.tab",
        "when": "agda-mode.inInputMode",
        "key": "tab"
      },
      {
        "command": "avea.auto-goal",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+a",
        "args": { "rewrite": "AsIs" }
      },
      {
        "command": "avea.auto-goal",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+c ctrl+a",
        "args": { "rewrite": "HeadNormal" }
      },
      {
        "command": "avea.auto-goal",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+u ctrl+c ctrl+a",
        "args": { "rewrite": "Normalised" }
      },
      {
        "command": "avea.compile-file",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+x ctrl+c"
      },
      {
        "command": "avea.make-case",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+c"
      },
      {
        "command": "avea.restart",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+x ctrl+r"
      },
      {
        "command": "avea.infer",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+d",
        "args": { "rewrite": "AsIs" }
      },
      {
        "command": "avea.infer",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+c ctrl+d",
        "args": { "rewrite": "HeadNormal" }
      },
      {
        "command": "avea.infer",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+u ctrl+c ctrl+d",
        "args": { "rewrite": "Normalised" }
      },
      {
        "command": "avea.compute",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+n",
        "args": { "computeMode": "DefaultCompute" }
      },
      {
        "command": "avea.compute",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+c ctrl+n",
        "args": { "computeMode": "IgnoreAbstract" }
      },
      {
        "command": "avea.compute",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+u ctrl+c ctrl+n",
        "args": { "computeMode": "UseShowInstance" }
      },
      {
        "command": "avea.compute",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+u ctrl+u ctrl+c ctrl+n",
        "args": { "computeMode": "HeadCompute" }
      },
      {
        "command": "avea.module-contents",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+o",
        "args": { "rewrite": "AsIs" }
      },
      {
        "command": "avea.module-contents",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+c ctrl+o",
        "args": { "rewrite": "HeadNormal" }
      },
      {
        "command": "avea.module-contents",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+u ctrl+c ctrl+o",
        "args": { "rewrite": "Normalised" }
      },
      {
        "command": "avea.why-in-scope",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+w"
      },
      {
        "command": "avea.toggle-hidden",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+x ctrl+h"
      },
      {
        "command": "avea.toggle-irrelevant",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+x ctrl+i"
      },
      {
        "command": "avea.search-about",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+c ctrl+z",
        "args": { "rewrite": "AsIs" }
      },
      {
        "command": "avea.search-about",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+c ctrl+z",
        "args": { "rewrite": "HeadNormal" }
      },
      {
        "command": "avea.search-about",
        "when": "editorLangId =~ /agda/ && !editor.hasSelection",
        "key": "ctrl+u ctrl+u ctrl+c ctrl+z",
        "args": { "rewrite": "Normalised" }
      }
    ],
    "commands": [
      {
        "command": "avea.load-file",
        "title": "Load an agda file"
      },
      {
        "command": "avea.give-goal",
        "title": "Give goal"
      },
      {
        "command": "avea.goal-context",
        "title": "Goal context"
      },
      {
        "command": "avea.refine",
        "title": "Refine goal"
      },
      {
        "command": "avea.next-goal",
        "title": "Next goal"
      },
      {
        "command": "avea.prev-goal",
        "title": "Previous goal"
      },
      {
        "command": "avea.show-constraints",
        "title": "Show constraints"
      },
      {
        "command": "avea.show-metas",
        "title": "Show all goals"
      },
      {
        "command": "avea.make-case",
        "title": "Make case"
      },
      {
        "command": "avea.auto-goal",
        "title": "Fill hole by automatic proof search"
      },
      {
        "command": "avea.compile-file",
        "title": "Compile file"
      },
      {
        "command": "avea.restart",
        "title": "Restart the agda process"
      }
    ]
  },
  "configurationDefaults": {
    "agda": {
      "editor.semanticHighlighting.enabled": true
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build:webview": "cd modules/avea && agda --js --js-es6 --js-verify --compile-dir=../../out --library-file=../../libraries --no-default-libraries src/Avea/Webview.agda",
    "build:extension": "cd modules/avea && agda --js --js-es6 --js-verify --compile-dir=../../out --library-file=../../libraries --no-default-libraries src/Avea/Extension.agda",
    "build": "npm run build:webview && npm run build:extension && cp modules/avea/src/extension.js out && node esbuild.mjs"
  },
  "dependencies": {
    "p-queue": "^9.1.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.0"
  }
}
